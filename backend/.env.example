PORT=5000
CLIENT_ORIGIN=http://localhost:3000,http://localhost:3001,https://thiri06.github.io
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<database>
TMDB_API_KEY=your_tmdb_api_key

# Choose one Firebase Admin configuration style.
# Option A: full service account JSON as one environment variable.
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}

# Option B: split values.
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@example.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
